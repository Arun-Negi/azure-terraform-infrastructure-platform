subscription_id = "00000000-0000-0000-0000-000000000000"

resource_groups = {
  platform_dev = {
    name     = "rg-platform-dev-eastus"
    location = "eastus"
    tags = {
      environment = "dev"
      managed_by  = "terraform"
      cost_center = "engineering"
    }
    virtual_network = {
      name          = "vnet-platform-dev"
      address_space = ["10.10.0.0/16"]
      subnets = {
        app = {
          name             = "snet-app"
          address_prefixes = ["10.10.1.0/24"]
        }
        data = {
          name             = "snet-data"
          address_prefixes = ["10.10.2.0/24"]
        }
      }
    }
  }

  shared_monitoring = {
    name     = "rg-shared-monitoring-eastus"
    location = "eastus"
    tags = {
      environment = "shared"
      managed_by  = "terraform"
    }
    # Omit virtual_network when this resource group does not need a VNet.
  }
}
