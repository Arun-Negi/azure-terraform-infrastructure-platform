{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Arun-Negi/azure-terraform-infrastructure-platform/main/schemas/services/resource-group.schema.json",
  "title": "Azure resource group schema",
  "description": "Validation rules for a resource group input object. Networking is an optional, separately governed service schema.",
  "$defs": {
    "resourceGroup": {
      "type": "object",
      "title": "Resource group",
      "description": "Generated name: {org}-{app}-{env}-rg-{instance}. Maximum 90 characters.",
      "additionalProperties": false,
      "required": [
        "instance"
      ],
      "properties": {
        "instance": {
          "$ref": "../common.schema.json#/$defs/instance",
          "title": "Resource-group instance"
        },
        "tags": {
          "type": "object",
          "title": "Tags (optional)",
          "description": "Optional Azure tags as string key/value pairs.",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "examples": [
            {
              "environment": "dev",
              "managed_by": "terraform"
            }
          ]
        },
        "virtual_network": {
          "title": "Virtual network (optional)",
          "description": "Include only if this resource group needs a VNet. See the virtual-network service schema for address-space and subnet suggestions.",
          "$ref": "./virtual-network.schema.json#/$defs/virtualNetwork"
        }
      }
    }
  }
}