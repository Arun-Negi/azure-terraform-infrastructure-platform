{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Arun-Negi/azure-terraform-infrastructure-platform/main/schemas/services/virtual-network.schema.json",
  "title": "Azure virtual network schema",
  "description": "Validation rules for a virtual network input object, including nested subnet inputs.",
  "$defs": {
    "virtualNetwork": {
      "type": "object",
      "title": "Virtual network (optional)",
      "description": "Include only if this resource group needs a VNet. Generated name limit: 64 characters.",
      "additionalProperties": false,
      "required": [
        "instance",
        "address_space"
      ],
      "properties": {
        "instance": {
          "$ref": "../common.schema.json#/$defs/instance",
          "title": "VNet instance"
        },
        "address_space": {
          "type": "array",
          "title": "VNet address space",
          "description": "One or more CIDR ranges, for example 10.10.0.0/16.",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$",
            "examples": [
              "10.10.0.0/16"
            ]
          }
        },
        "subnets": {
          "type": "array",
          "title": "Subnets (optional)",
          "default": [],
          "items": {
            "$ref": "./subnet.schema.json#/$defs/subnet"
          }
        }
      }
    }
  }
}
