{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Arun-Negi/azure-terraform-infrastructure-platform/main/schemas/services/subnet.schema.json",
  "title": "Azure subnet schema",
  "description": "Validation rules for a subnet input object.",
  "$defs": {
    "subnet": {
      "type": "object",
      "title": "Subnet",
      "description": "Generated name: {org}-{app}-{env}-snet-{instance}. Maximum 80 characters.",
      "additionalProperties": false,
      "required": [
        "instance",
        "address_prefixes"
      ],
      "properties": {
        "instance": {
          "$ref": "../common.schema.json#/$defs/instance",
          "title": "Subnet instance"
        },
        "address_prefixes": {
          "type": "array",
          "title": "Subnet CIDR ranges",
          "description": "Ensure each range fits inside the VNet and does not overlap another subnet.",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])$",
            "examples": [
              "10.10.1.0/24"
            ]
          }
        }
      }
    }
  }
}
