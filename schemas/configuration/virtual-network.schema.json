{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Virtual Network input file",
  "type": "object",
  "additionalProperties": false,
  "required": ["instance", "address_space"],
  "properties": {
    "instance": { "$ref": "../common.schema.json#/$defs/instance" },
    "address_space": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/([0-9]|[1-2][0-9]|3[0-2])$" } }
  }
}
