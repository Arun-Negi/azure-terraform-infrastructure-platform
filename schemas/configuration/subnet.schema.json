{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subnet input file",
  "type": "object",
  "additionalProperties": false,
  "required": ["subnets"],
  "properties": {
    "subnets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance", "address_prefixes"],
        "properties": {
          "instance": { "$ref": "../services/common.schema.json#/$defs/instance" },
          "address_prefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "ipv4" } }
        }
      }
    }
  }
}
