variable "name" {
  description = "Validated storage account name generated by the shared naming module."
  type        = string
  nullable    = false
  validation {
    condition     = length(var.name) >= 3 && length(var.name) <= 24 && can(regex("^[a-z0-9]+$", var.name))
    error_message = "Azure storage account names must contain 3-24 lowercase letters or digits only."
  }
}

variable "resource_group_name" {
  description = "Existing resource group in which the storage account is created."
  type        = string
  nullable    = false
}

variable "location" {
  description = "Platform-controlled Azure location."
  type        = string
  default     = "centralus"
  nullable    = false
  validation {
    condition     = var.location == "centralus"
    error_message = "This platform supports Central US (centralus) only."
  }
}

variable "account_tier" {
  description = "Storage performance tier; this platform currently allows Standard only."
  type        = string
  default     = "Standard"
  nullable    = false
  validation {
    condition     = var.account_tier == "Standard"
    error_message = "Only the Standard storage account tier is allowed."
  }
}

variable "replication_type" {
  description = "Approved storage redundancy option."
  type        = string
  default     = "LRS"
  nullable    = false
  validation {
    condition     = contains(["LRS", "GRS", "RAGRS", "ZRS", "GZRS", "RAGZRS"], var.replication_type)
    error_message = "replication_type must be LRS, GRS, RAGRS, ZRS, GZRS, or RAGZRS."
  }
}

variable "min_tls_version" {
  description = "Minimum TLS version; TLS 1.2 is mandatory."
  type        = string
  default     = "TLS1_2"
  nullable    = false
  validation {
    condition     = var.min_tls_version == "TLS1_2"
    error_message = "Storage accounts must use TLS1_2; this is the platform standard."
  }
}

variable "public_network_access_enabled" {
  description = "Whether public network access is enabled. Disabled by default."
  type        = bool
  default     = false
  nullable    = false
}

variable "shared_access_key_enabled" {
  description = "Whether shared-key authentication is enabled. Disabled by default."
  type        = bool
  default     = false
  nullable    = false
}

variable "tags" {
  description = "Azure tags inherited from the resource group and optionally overridden per storage account."
  type        = map(string)
  default     = {}
  nullable    = false
}
